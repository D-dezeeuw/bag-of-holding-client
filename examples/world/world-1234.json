    "legend": {
      "provisional": false,
      "title": "The Unseen Siege",
      "kernelOfTruth": "No one speaks of the day the walls wept iron and the sky forgot its color.",
      "payoff": "To uncover the truth is to become part of the silence that followed — and the next assault begins when you stop looking.",
      "hooks": [
        "A child draws the same symbol in ash every dawn — it matches the scars on the Bastion’s gate.",
        "A mendicant priest claims he heard the siege’s final scream… and it was his own voice.",
        "The March’s corpses still march — but only when no living eyes are upon them."
      ],
      "id": "continent-0.legend-0",
      "era": "era-0",
      "digest": "The Unseen Siege was not hidden — it was witnessed, and then unanimously unremembered. To speak of it invites the next wave. Those who remember are marked — not by scars, but by the absence of others’ gaze when they speak."
    },
