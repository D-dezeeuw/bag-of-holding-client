  "hydrated": {
    "region": {
      "id": "Ironvale",
      "provisional": false,
      "name": "Ironvale",
      "description": "Nestled where the iron-rich cliffs of Ironcoast meet the whispering pines of Velwyn’s western foothills, Ironvale is a place where the land remembers industry even as it tries to forget it. Once the beating heart of Velwyn’s metallurgical age — its waterwheels turning relentless hammers, its smokestacks staining the dawn — the town now slumbers under moss and rust. The great mill still stands, its timbers groaning with the weight of forgotten shifts, its waterwheel turned slow by neglect, yet still turning… as if compelled by something beneath the stones.",
      "rumor": "They say if you listen at midnight beside the broken bellows, you can hear the rhythm of a shift that never ended — clanking, coughing, and the soft, wet whisper of something breathing in the dark where the ore veins run deep.",
      "adjacentHints": [
        "To the east, Ironcoast’s salt-worn docks groan under the weight of ships that never come — or worse, the ones that do, and never leave.",
        "To the west, Velwyn’s ancient forests thicken, and the trees grow strange — their bark etched with symbols that match the mill’s forgotten gear patterns."
      ],
      "climate": "temperate",
      "settlementName": "Ironvale",
      "dungeonName": "The Gears That Still Turn",
      "digest": "A mill town haunted not by ghosts, but by the echo of labor that refused to die — where the machines remember what the people have tried to bury."
    },
